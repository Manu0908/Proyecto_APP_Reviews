# ==============================================================================
# PROYECTO RESEÑAS — VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a `.env.local` y configura tus credenciales reales.
# Si no se definen, la aplicación opera automáticamente en modo resiliente
# utilizando el catálogo verificado local (`MOCK_RESTAURANTS`) sin errores.

# 1. Supabase (PostgreSQL 15+ con PostGIS, Auth y Storage) — Plan Free ($0.00)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica"

# 2. CARTO Basemaps (Opcional — URL de estilo vectorial Dark Matter GL)
NEXT_PUBLIC_CARTO_STYLE_URL="https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json"

# 3. Token secreto opcional para el endpoint /api/health (Keep-Alive cada 4 días)
HEALTHCHECK_SECRET="token-opcional-keep-alive"
